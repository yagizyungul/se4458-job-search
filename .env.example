# Optional - leave empty for demo / static AI fallback.
# Anthropic is used first when both keys are set.
ANTHROPIC_API_KEY=

# Optional - Google Gemini API key. Either name works.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional - set when you wire up Supabase Auth in production
SUPABASE_JWT_SECRET=dev-secret
